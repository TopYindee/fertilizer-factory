    -- observability-slow-queries-count
    set search_path to public, extensions;

    SELECT
      CASE
        WHEN EXISTS (
          SELECT 1 FROM pg_extension WHERE extname = 'pg_stat_statements'
        )
        THEN (
          SELECT count(*)::int
          FROM pg_stat_statements
          WHERE total_exec_time + total_plan_time > 1000
        )
